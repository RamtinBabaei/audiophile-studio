# No credentials are required for local development.
# Data is stored in local Cloudflare D1 emulation after pnpm db:migrate:local.
# Optional when running Playwright against a different local server:
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# Optional public origin for social sharing metadata.
# GitHub Actions reads this from the SITE_URL repository variable.
# NEXT_PUBLIC_SITE_URL=https://audiophile-studio.YOUR_SUBDOMAIN.workers.dev
