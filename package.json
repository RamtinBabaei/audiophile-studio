{
  "name": "audiophile-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write app components/store lib/shop db tests docs README.md",
    "format:check": "prettier --check app components/store lib/shop db tests docs README.md",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "preview:production": "node scripts/preview-production.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.2",
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "vitest": "^5.0.4",
    "wrangler": "4.150.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
